# ACE-Step install — local content, several GB, never committed
# Absolute path to your ACE-Step-1.5 checkout (contains checkpoints/ and .venv/).
# No variable expansion — paste a literal absolute path, your OS format:
#   Linux/macOS:  ACESTEP_HOME=/home/<user>/acestep/ACE-Step-1.5
#   Windows:      ACESTEP_HOME=C:/Users/<user>/acestep/ACE-Step-1.5
ACESTEP_HOME=/path/to/ACE-Step-1.5

# Tavily — MCP web search
TAVILY_API_KEY=
